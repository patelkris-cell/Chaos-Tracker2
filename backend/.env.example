# Copy this file to .env and fill in real values.
# .env is already in .gitignore -- never commit real secrets.

# --- Database ---
# Local quick test (no setup needed): sqlite:///./chaos.db
# Supabase (recommended for deploying): Project Settings -> Database ->
# Connection string (URI tab, "Session pooler" -- works better than "Direct
# connection" for a server that starts/stops a lot):
#   postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-xxxx.pooler.supabase.com:5432/postgres
DATABASE_URL=sqlite:///./chaos.db

# --- Auth ---
# Any long random string. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Phone verification ---
# "mock" = no SMS is actually sent; the code is always 123456 and is returned
# in the API response, so you can build/test with zero third-party accounts.
# "textbelt" = real SMS via textbelt.com, zero signup (see app/otp.py for
# free-tier limits). "twilio" = real SMS via Twilio -- fill in the three
# TWILIO_* values below and `pip install twilio` first.
OTP_PROVIDER=mock

# Only needed when OTP_PROVIDER=textbelt. Default value is Textbelt's public
# free-tier key (1 text/day, shared). Get your own paid key at textbelt.com
# for more.
TEXTBELT_API_KEY=textbelt

# Only needed when OTP_PROVIDER=twilio. Get these from console.twilio.com:
# TWILIO_ACCOUNT_SID and TWILIO_AUTH_TOKEN are on the main dashboard.
# TWILIO_FROM_NUMBER is a phone number you own there, E.164 format (e.g. +15551234567).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- CORS ---
# Comma-separated list of origins allowed to call this API from a browser.
# Include "null" if you ever open the frontend as a local file:// (browsers
# send Origin: null for those). Add your deployed frontend's real URL here
# too once you have one (e.g. https://chaos-tracker.onrender.com).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5500,null

# --- GIF search (Klipy) ---
# Free key at https://klipy.com/developers. Leave blank and the GIF picker
# just reports itself unavailable instead of failing.
KLIPY_API_KEY=

# --- Password reset email (Gmail SMTP) ---
# Your own Gmail address, plus a 16-character "app password" (NOT your real
# Gmail password) -- generate one at myaccount.google.com/apppasswords
# (requires 2-Step Verification to be on first). Leave either blank and the
# email-reset endpoint reports itself unavailable; SMS-based reset still
# works independently.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Where the frontend actually lives, so a password-reset email/SMS can build
# a real clickable link. Local dev with the file opened directly:
#   file:///Users/yourname/Public/chaos-tracker/frontend/chaos-tracker-live.html
# Deployed: your Render static site's URL, e.g.
#   https://chaos-tracker.onrender.com/chaos-tracker-live.html
FRONTEND_BASE_URL=

# --- Photo/GIF uploads ---
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=8

# Cloudflare R2 (optional, recommended once deployed) -- makes uploaded
# photos/GIFs persistent instead of living on local disk, which most hosts
# wipe on redeploy. Leave all four blank to keep using local disk. See the
# R2_* settings' comments in app/config.py for the full setup steps.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# --- AI chatbot (/chat endpoint) ---
# Get a key at https://console.anthropic.com (Settings -> API Keys). Leave
# blank and every other endpoint still works -- only /chat is disabled.
ANTHROPIC_API_KEY=
# Verify the current model ID at https://docs.claude.com/en/docs/about-claude/models
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Census migration data (one of the /chat tools, and address geocoding) ---
# Free, instant signup at https://api.census.gov/data/key_signup.html
# Leave blank and get_county_migration will just report itself unavailable.
CENSUS_API_KEY=
